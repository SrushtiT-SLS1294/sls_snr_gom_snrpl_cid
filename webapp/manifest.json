{
  "_version": "1.83.0",
  "sap.app": {
    "id": "snrprtl.slssnrgomsnrpl",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.22.0",
      "toolsId": "51e88389-b624-476b-8a16-528e69d835f5"
    },
    "dataSources": {
      "mainService": {
        "uri": "/v2/northwind/northwind.svc/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "snrprtl-display": {
          "semanticObject": "snrprtl",
          "action": "display",
          "title": "{{snrprtl-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.146.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "snrprtl.slssnrgomsnrpl.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "snrprtl.slssnrgomsnrpl.view",
        "async": true,
        "viewPath": "snrprtl.slssnrgomsnrpl.view"
      },
      "routes": [
        {
          "name": "RouteWorklist",
          "pattern": ":?query:",
          "target": [
            "TargetWorklist"
          ]
        },
         {
          "name": "Object",
          "pattern": "Object/{objectId}",
          "target": [
            "Object"
          ]
        }
      ],
      "targets": {
        "TargetWorklist": {
          "id": "Worklist",
          "name": "Worklist"
        },
         "Object": {
          "id": "Object",
          "name": "Object"
        }
      }
    },
    "rootView": {
      "viewName": "snrprtl.slssnrgomsnrpl.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "snrprtlslssnrgomsnrpl"
  }
}
